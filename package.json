{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/ensure-pnpm.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "build:railway": "node scripts/railway-build.mjs",
    "db:push": "pnpm --filter @workspace/db run push",
    "db:push:prod": "node scripts/railway-db-push.mjs",
    "start:railway": "node --import ./artifacts/api-server/load-env.mjs ./artifacts/api-server/dist/index.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "packageManager": "pnpm@10.24.0",
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
