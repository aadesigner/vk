    "@workspace/vin-page-seo": "workspace:*",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.0",
    "drizzle-orm": "catalog:",
